/*
 * ESP32-C3 SuperMini + TSL2591 + BLE (Nordic UART)
 *
 * Placa: ESP32C3 Dev Module | USB CDC On Boot: Enabled
 * I2C: SDA=8, SCL=9
 *
 * App Android envia "M" -> ESP responde uma linha:
 *   DATA;IR=794;FULL=1769;VISIBLE=975;LUX=29.23
 *
 * Nome BLE: Espectro-TSL
 *
 * Desenvolvido por Kaique de Sotti Silva
 */

#include <Wire.h>
#include "Adafruit_TSL2591.h"
#include <BLEDevice.h>
#include <BLEServer.h>
#include <BLEUtils.h>
#include <BLE2902.h>

#define I2C_SDA 8
#define I2C_SCL 9
#define DEVICE_NAME "Espectro-TSL"

#define SERVICE_UUID           "6E400001-B5A3-F393-E0A9-E50E24DCCA9E"
#define CHARACTERISTIC_UUID_RX "6E400002-B5A3-F393-E0A9-E50E24DCCA9E"
#define CHARACTERISTIC_UUID_TX "6E400003-B5A3-F393-E0A9-E50E24DCCA9E"

Adafruit_TSL2591 tsl = Adafruit_TSL2591(2591);

BLEServer *pServer = nullptr;
BLECharacteristic *pTxCharacteristic = nullptr;
bool deviceConnected = false;
bool sensorOk = false;

class ServerCallbacks : public BLEServerCallbacks {
  void onConnect(BLEServer *server) override {
    deviceConnected = true;
    Serial.println(F("BLE: cliente conectado"));
    // Intervalo de conexão mais estável (unidade: 1,25 ms)
    server->updateConnParams(0x10, 0x20, 0, 400);
  }
  void onDisconnect(BLEServer *server) override {
    deviceConnected = false;
    Serial.println(F("BLE: cliente desconectado"));
    delay(200);
    BLEDevice::startAdvertising();
    Serial.println(F("BLE: anunciando novamente"));
  }
};

void sendBle(const String &msg) {
  if (!deviceConnected || pTxCharacteristic == nullptr) return;
  String out = msg;
  out += '\n';
  pTxCharacteristic->setValue(out.c_str());
  pTxCharacteristic->notify();
}

bool readSensor(uint16_t &ir, uint16_t &full, uint16_t &visible, float &lux) {
  if (!sensorOk) return false;

  uint32_t lum = tsl.getFullLuminosity();
  ir = lum >> 16;
  full = lum & 0xFFFF;
  visible = (full > ir) ? (full - ir) : 0;
  lux = tsl.calculateLux(full, ir);
  return true;
}

String formatMeasurement(uint16_t ir, uint16_t full, uint16_t visible, float lux) {
  String line = "DATA;IR=";
  line += ir;
  line += ";FULL=";
  line += full;
  line += ";VISIBLE=";
  line += visible;
  line += ";LUX=";
  line += String(lux, 2);
  return line;
}

void sendMeasurement() {
  uint16_t ir = 0, full = 0, visible = 0;
  float lux = 0;

  if (!readSensor(ir, full, visible, lux)) {
    sendBle("ERR;MSG=SENSOR");
    Serial.println(F("ERR sensor"));
    return;
  }

  String line = formatMeasurement(ir, full, visible, lux);
  sendBle(line);

  Serial.print(F("IR: "));
  Serial.print(ir);
  Serial.print(F("  Full: "));
  Serial.print(full);
  Serial.print(F("  Visible: "));
  Serial.print(visible);
  Serial.print(F("  Lux: "));
  Serial.println(lux, 2);
}

class RxCallbacks : public BLECharacteristicCallbacks {
  void onWrite(BLECharacteristic *pCharacteristic) override {
    std::string raw = pCharacteristic->getValue();
    if (raw.empty()) return;

    Serial.print(F("BLE RX: "));
    Serial.println(raw.c_str());

    if (raw.find('M') != std::string::npos || raw.find('m') != std::string::npos) {
      sendMeasurement();
    }
  }
};

void setup() {
  Serial.begin(115200);
  delay(500);

  Wire.begin(I2C_SDA, I2C_SCL);
  Wire.setClock(100000);

  if (tsl.begin()) {
    sensorOk = true;
    tsl.setGain(TSL2591_GAIN_MED);
    tsl.setTiming(TSL2591_INTEGRATIONTIME_300MS);
    Serial.println(F("TSL2591 OK"));
  } else {
    Serial.println(F("TSL2591 ausente"));
  }

  BLEDevice::init(DEVICE_NAME);
  BLEDevice::setPower(ESP_PWR_LVL_P9);
  pServer = BLEDevice::createServer();
  pServer->setCallbacks(new ServerCallbacks());

  BLEService *pService = pServer->createService(SERVICE_UUID);
  pTxCharacteristic = pService->createCharacteristic(
      CHARACTERISTIC_UUID_TX, BLECharacteristic::PROPERTY_NOTIFY);
  pTxCharacteristic->addDescriptor(new BLE2902());

  BLECharacteristic *pRxCharacteristic = pService->createCharacteristic(
      CHARACTERISTIC_UUID_RX,
      BLECharacteristic::PROPERTY_WRITE | BLECharacteristic::PROPERTY_WRITE_NR);
  pRxCharacteristic->setCallbacks(new RxCallbacks());

  pService->start();

  BLEAdvertising *pAdvertising = BLEDevice::getAdvertising();

  BLEAdvertisementData advData;
  advData.setFlags(0x06);
  advData.setName(DEVICE_NAME);
  advData.setCompleteServices(BLEUUID(SERVICE_UUID));

  BLEAdvertisementData scanData;
  scanData.setName(DEVICE_NAME);

  pAdvertising->setAdvertisementData(advData);
  pAdvertising->setScanResponseData(scanData);
  pAdvertising->setMinPreferred(0x06);
  pAdvertising->setMaxPreferred(0x12);
  BLEDevice::startAdvertising();

  Serial.println(F("BLE ativo: Espectro-TSL (envie M para medir)"));
  Serial.print(F("MAC: "));
  Serial.println(BLEDevice::getAddress().toString().c_str());
}

void loop() {
  delay(20);
}
